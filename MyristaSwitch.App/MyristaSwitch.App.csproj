<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyristaSwitch</AssemblyName>
    <RootNamespace>MyristaSwitch.App</RootNamespace>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <Authors>MyristaSwitch contributors</Authors>
    <Description>KMS-aware display profile switcher for Windows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 MyristaSwitch contributors</Copyright>
  </PropertyGroup>

</Project>
